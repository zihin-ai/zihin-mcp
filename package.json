{
  "name": "@zihin/mcp-server",
  "version": "2.2.3",
  "mcpName": "ai.zihin/mcp-server",
  "description": "Zihin MCP server: a stdio-to-HTTP proxy for Claude Desktop, Cursor, Claude Code and other MCP clients.",
  "type": "module",
  "bin": {
    "zihin-mcp": "bin/zihin-mcp.js"
  },
  "scripts": {
    "test": "node --test",
    "check:publication": "node scripts/check-publication.mjs",
    "prepack": "npm run check:publication"
  },
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/zihin-mcp.js",
    "src/index.js",
    "src/install-skills.js",
    "plugin/.claude-plugin/plugin.json",
    "plugin/.mcp.json",
    "plugin/README.md",
    "plugin/skills/*/SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "zihin",
    "ai",
    "agents",
    "claude",
    "cursor",
    "model-context-protocol"
  ],
  "author": "Zihin.ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zihin-ai/zihin-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0"
  }
}
